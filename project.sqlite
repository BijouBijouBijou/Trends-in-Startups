/* Let's find out the valuations among different sectors:
7.  Return the average valuation.
8.  Return the average valuation, in each category.
9.  Cont 8, Round to 2 decimal places
*/
--  SELECT AVG(valuation) FROM startups;
SELECT category, ROUND(AVG(valuation), 2) FROM startups
GROUP BY category;
/* 10.
Return the average valuation, in each category.

Round the averages to two decimal places.

Lastly, order the list from highest averages to lowest.
*/
SELECT category, ROUND(AVG(valuation), 2) AS 'Average Value' FROM startups
GROUP BY 1
ORDER BY 2 DESC;

/*  
What are the most competitive markets?

11. First, return the name of each category with the total number of companies that belong to it.

12.Next, filter the result to only include categories that have more than three companies in them.
What are the most competitive markets?
*/

SELECT category, COUNT(*) AS "Number of Companies" FROM startups
GROUP BY category
HAVING COUNT(*) > 3
ORDER BY COUNT(*) DESC;

/* 
Let's see if there's a difference in startups sizes among different locations:

13.What is the average size of a startup in each location?

14.What is the average size of a startup in each location, with average sizes above 500?

Added extra code to order it from largest to smallest with ORDER BY at end.
*/

SELECT location, ROUND(AVG(employees),0) AS "Average Number of Employees" FROM startups
GROUP BY location
HAVING ROUND(AVG(employees),0) > 500
ORDER BY 2 DESC;



